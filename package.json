{
  "name": "early-performance-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible development builds for the Early Performance Optimizer extension",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "test": "node --test tests/*.test.*",
    "test:browser": "npm run build:chrome && node --test tests/browser.acceptance.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
