{
  "manifest_version": 3,
  "name": "Early Performance Optimizer",
  "version": "1.0",
  "description": "Optimizes web pages before they load",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
